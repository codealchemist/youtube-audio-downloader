{
  "name": "yasapp",
  "productName": "yasapp",
  "version": "1.0.0",
  "description": "Download audio from YouTube videos as mp3.",
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron-forge start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm test && npm run test:e2e",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "keywords": [],
  "author": {
    "name": "Alberto Miranda",
    "email": "codealchemist@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^12.0.0",
    "ffmpeg-static": "^5.3.0",
    "youtube-audio-server": "^3.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "electron": "^44.9.0",
    "eslint": "^10.13.0",
    "globals": "^15.15.0",
    "neostandard": "^0.14.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.4": true,
    "fsevents": false
  }
}
